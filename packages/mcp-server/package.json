{
  "name": "@mcpfind/server",
  "version": "0.1.0",
  "description": "MCP server for searching the MCPFind directory.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MCPFind/mcp-find.git",
    "directory": "packages/mcp-server"
  },
  "homepage": "https://mcpfind.org",
  "bugs": "https://github.com/MCPFind/mcp-find/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcpfind",
    "mcp-server"
  ],
  "engines": {
    "node": ">=18"
  },
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "mcpfind": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "postbuild": "node -e \"require('node:fs').chmodSync('dist/index.js', 0o755)\"",
    "prepack": "npm run build",
    "type-check": "tsc --noEmit",
    "test:protocol": "node scripts/protocol-test.mjs",
    "test:docs": "node scripts/docs-test.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^22",
    "typescript": "^5"
  },
  "publishConfig": {
    "access": "public"
  }
}
